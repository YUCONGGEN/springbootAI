include README.md
include LICENSE
include CHANGELOG.md
include SECURITY.md
include requirements.txt
include requirements-ai.txt
include requirements-langgraph.txt
include requirements-mcp.txt
include pyproject.toml

graft spring
graft sql

# 排除开发/构建产物
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
prune build
prune dist
prune .pytest_cache
prune .venv
prune logs
