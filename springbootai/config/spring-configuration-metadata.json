{
  "version": 1,
  "metadata": {
    "description": "SpringBootAI 配置元数据（对齐 Spring Boot additional-spring-configuration-metadata.json）",
    "note": "IDE 可读取此文件提供配置自动补全和文档提示"
  },
  "properties": [
    {"name": "server.port", "type": "java.lang.Integer", "description": "HTTP 服务端口", "defaultValue": 8000},
    {"name": "server.host", "type": "java.lang.String", "description": "HTTP 服务绑定地址", "defaultValue": "0.0.0.0"},
    {"name": "server.cors.allow-origins", "type": "java.util.List<java.lang.String>", "description": "CORS 允许的源列表"},
    {"name": "server.cors.allow-credentials", "type": "java.lang.Boolean", "description": "CORS 是否允许携带凭证", "defaultValue": false},
    {"name": "server.csrf.enabled", "type": "java.lang.Boolean", "description": "是否启用 CSRF 防护（Bearer Token 认证无需开启）", "defaultValue": false},

    {"name": "spring.application.name", "type": "java.lang.String", "description": "应用名称"},
    {"name": "spring.profiles.active", "type": "java.lang.String", "description": "激活的 Profile"},

    {"name": "spring.devtools.restart.enabled", "type": "java.lang.Boolean", "description": "是否启用 DevTools 热重载（仅开发环境）", "defaultValue": false},
    {"name": "spring.devtools.restart.poll-interval", "type": "java.lang.Float", "description": "文件轮询间隔（秒）", "defaultValue": 1.0},

    {"name": "spring.datasource.url", "type": "java.lang.String", "description": "数据库连接 URL"},
    {"name": "spring.datasource.username", "type": "java.lang.String", "description": "数据库用户名"},
    {"name": "spring.datasource.password", "type": "java.lang.String", "description": "数据库密码"},
    {"name": "spring.datasource.driver-class-name", "type": "java.lang.String", "description": "数据库驱动类名"},
    {"name": "spring.datasource.pool-size", "type": "java.lang.Integer", "description": "连接池大小", "defaultValue": 10},

    {"name": "spring.ddl-auto.mode", "type": "java.lang.String", "description": "DDL 自动生成模式 (none/create/update/validate/create-drop)", "defaultValue": "none"},
    {"name": "spring.ddl-auto.entity-packages", "type": "java.util.List<java.lang.String>", "description": "@Entity 实体类所在包列表"},

    {"name": "spring.security.jwt.secret-key", "type": "java.lang.String", "description": "JWT 签名密钥（长度 >= 32，生产环境必须配置）"},
    {"name": "spring.security.jwt.access-token-expiry", "type": "java.lang.Integer", "description": "Access Token 过期时间（秒）", "defaultValue": 3600},
    {"name": "spring.security.jwt.refresh-token-expiry", "type": "java.lang.Integer", "description": "Refresh Token 过期时间（秒）", "defaultValue": 604800},

    {"name": "spring.security.oauth2.resourceserver.jwt.issuer-uri", "type": "java.lang.String", "description": "OAuth2 Authorization Server 的 Issuer URI"},
    {"name": "spring.security.oauth2.resourceserver.jwt.jwk-set-uri", "type": "java.lang.String", "description": "OAuth2 JWKS 公钥集 URI"},

    {"name": "spring.rabbitmq.host", "type": "java.lang.String", "description": "RabbitMQ 主机", "defaultValue": "localhost"},
    {"name": "spring.rabbitmq.port", "type": "java.lang.Integer", "description": "RabbitMQ 端口", "defaultValue": 5672},

    {"name": "spring.kafka.bootstrap-servers", "type": "java.lang.String", "description": "Kafka Bootstrap Servers", "defaultValue": "localhost:9092"},
    {"name": "spring.kafka.consumer.group-id", "type": "java.lang.String", "description": "Kafka 消费者组 ID"},
    {"name": "spring.kafka.consumer.auto-offset-reset", "type": "java.lang.String", "description": "Kafka 消费者 Offset 重置策略 (latest/earliest)", "defaultValue": "latest"},

    {"name": "spring.redis.host", "type": "java.lang.String", "description": "Redis 主机", "defaultValue": "localhost"},
    {"name": "spring.redis.port", "type": "java.lang.Integer", "description": "Redis 端口", "defaultValue": 6379},

    {"name": "spring.cloud.nacos.discovery.server-addr", "type": "java.lang.String", "description": "Nacos 服务发现地址"},
    {"name": "spring.cloud.seata.mode", "type": "java.lang.String", "description": "Seata 分布式事务模式 (at/tcc/http/distributed)", "defaultValue": "at"},

    {"name": "management.endpoints.web.security.enabled", "type": "java.lang.Boolean", "description": "Actuator 敏感端点鉴权开关", "defaultValue": true},
    {"name": "management.endpoints.web.security.roles", "type": "java.util.List<java.lang.String>", "description": "Actuator 访问角色列表", "defaultValue": ["ADMIN", "ACTUATOR"]},
    {"name": "management.admin.request-metrics.enabled", "type": "java.lang.Boolean", "description": "是否启用框架内置请求持久化监控；默认关闭", "defaultValue": false},
    {"name": "management.admin.request-metrics.title", "type": "java.lang.String", "description": "Admin 面板应用请求统计卡片标题", "defaultValue": "业务请求监控"},
    {"name": "management.admin.request-metrics.include-paths", "type": "java.util.List<java.lang.String>", "description": "需要统计的业务路径白名单；未配置时采集所有非运维路径，例如 [\"/api/**\"]", "defaultValue": []},
    {"name": "management.admin.request-metrics.exclude-paths", "type": "java.util.List<java.lang.String>", "description": "额外排除的路径；框架始终排除 /actuator/**、接口文档和 favicon", "defaultValue": []},
    {"name": "management.admin.request-metrics.table", "type": "java.lang.String", "description": "请求持久化监控使用的数据表名；非法名称回退为 springbootai_request_metrics", "defaultValue": "springbootai_request_metrics"},

    {"name": "spring.ai.provider", "type": "java.lang.String", "description": "AI 模型提供商 (openai/deepseek/ollama/zhipu/fake)"},
    {"name": "spring.ai.api-key", "type": "java.lang.String", "description": "AI API Key"},
    {"name": "spring.ai.allow-fake", "type": "java.lang.Boolean", "description": "无 API Key 时是否降级 FakeChatModel", "defaultValue": false}
  ]
}
